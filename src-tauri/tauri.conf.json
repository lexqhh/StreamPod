{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "StreamPod",
  "version": "0.3.0-rc.3",
  "identifier": "com.streampod.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "StreamPod - Sauvegarde OBS",
        "width": 960,
        "height": 680,
        "minWidth": 760,
        "minHeight": 560,
        "center": true,
        "backgroundColor": "#0a0a0a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "fileAssociations": [
      {
        "ext": ["obsbackup"],
        "name": "Sauvegarde OBS",
        "description": "Sauvegarde OBS créée avec StreamPod",
        "role": "Editor"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEzQkU2RDBDMTc2NEQ0NApSV1JFVFhiQjBPWTdDcmR6VDdrOTJlbitWYUtsaldqWWJtUWhLaDE2NHgyS3lQVmRsSFJCUmZxaQo=",
      "endpoints": [
        "https://github.com/lexqhh/StreamPod/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
